#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
cd "$(dirname "$0")"
envfile=${HEJI_ENV_FILE:?}
vardir=${HEJI_VAR:?}
case "${1:-}" in ''|--local-cert) ;; *) echo '支持 init 或 init --local-cert' >&2; exit 2;; esac
mkdir -p "$(dirname "$envfile")" "$vardir/tls"
exec 9>"$vardir/deploy.lock"
flock -x 9
stage=$(mktemp -d "$vardir/tls/.init.XXXXXXXX")
env_temp=''
trap 'rm -rf -- "$stage"; if [[ -n "$env_temp" ]]; then rm -f -- "$env_temp"; fi' EXIT
if [[ ! -e "$envfile" ]]; then
    env_temp=$(mktemp "$(dirname "$envfile")/.heji-init.XXXXXXXX")
    python3 - "$env_temp" <<'PY'
import base64, pathlib, secrets, sys
keys = {'APP_KEY': 'base64:' + base64.b64encode(secrets.token_bytes(32)).decode(),
        **{k: secrets.token_hex(32) for k in ('DB_PASSWORD', 'DB_OWNER_PASSWORD', 'REDIS_PASSWORD')}}
with open(sys.argv[1], 'w') as output:
    for line in pathlib.Path('.env.example').read_text().splitlines():
        name = line.partition('=')[0]
        print(f'{name}={keys[name]}' if name in keys else line, file=output)
PY
    mv -- "$env_temp" "$envfile"
fi
chmod 0600 "$envfile"

# SSL 证书：已有则保留，没有则创建；仅本地自签证书过期时自动续期。
# --local-cert 保留兼容，行为与不带参数的 init 相同。
cert="$vardir/tls/fullchain.pem"; key="$vardir/tls/privkey.pem"
if [[ -f "$cert" && -s "$cert" && -f "$key" && -s "$key" ]]; then
    chmod 0600 "$key"
    if ! openssl x509 -in "$cert" -noout >/dev/null 2>&1; then
        echo '已有证书无法解析，请使用 tls-import 重新导入配套证书。' >&2; exit 1
    fi
    openssl x509 -in "$cert" -pubkey -noout > "$stage/cert.pub"
    if ! openssl pkey -passin pass: -in "$key" -pubout > "$stage/key.pub" 2>/dev/null \
       || ! cmp -s "$stage/cert.pub" "$stage/key.pub"; then
        echo '已有证书与私钥不匹配，请使用 tls-import 导入配套证书。' >&2; exit 1
    fi
    if openssl x509 -in "$cert" -noout -checkend 0 >/dev/null; then
        echo '已检测到有效 SSL 证书，保留现有文件：'
        openssl x509 -in "$cert" -noout -subject -enddate
        exit 0
    fi
    issuer=$(openssl x509 -in "$cert" -noout -issuer); issuer=${issuer#issuer=}
    subject=$(openssl x509 -in "$cert" -noout -subject); subject=${subject#subject=}
    if [[ "$issuer" != "$subject" ]]; then
        echo '警告：正式证书已过期，请使用 tls-import 导入新证书（未改动现有文件）。' >&2
        exit 0
    fi
    echo '本地自签证书已过期，重新生成。' >&2
elif [[ -e "$cert" || -e "$key" ]]; then
    echo '已有证书文件不完整，请使用 tls-import 导入配套证书。' >&2; exit 1
fi
openssl req -x509 -newkey rsa:3072 -sha256 -nodes -days 90 -subj "/CN=shop.laravel.demo" \
  -addext "subjectAltName=DNS:shop.laravel.demo,DNS:stock.laravel.demo,DNS:recipe.laravel.demo" \
  -keyout "$stage/key" -out "$stage/cert"
chmod 0644 "$stage/cert"
if [[ -f "$key" ]]; then cp -p "$key" "$stage/previous-key"; fi
mv -- "$stage/key" "$key"
if ! mv -- "$stage/cert" "$cert"; then
    if [[ -e "$stage/previous-key" ]]; then mv -- "$stage/previous-key" "$key"
    else rm -f -- "$key"; fi
    exit 1
fi
echo '已生成本地自签 SSL 证书（90 天，覆盖三个域名）。'