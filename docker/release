#!/usr/bin/env bash
# All changes to the live application follow the isolated test and HTTPS gates.
set -Eeuo pipefail
cd "${HEJI_SOURCE_DIR:?}"
umask 077
root=$PWD
config_dir=${HEJI_CONFIG_DIR:-$root}
live_var=$(realpath "${HEJI_VAR:-$config_dir/var}")
live_env=$(realpath "${HEJI_ENV_FILE:-$config_dir/.env}")
[[ -f "$live_env" && -s "$live_var/tls/fullchain.pem" && -s "$live_var/tls/privkey.pem" ]] || { echo '请初始化环境并安装 TLS 证书。' >&2; exit 1; }
mkdir -p "$live_var/releases"
exec 9>"$live_var/deploy.lock"
flock -n 9 || { echo '已有发布任务。' >&2; exit 1; }
tag=${1:-latest}
if [[ "$tag" == latest ]]; then
    tag=$(date -u +%Y%m%d%H%M%S)-$(git rev-parse --short HEAD 2>/dev/null || echo local)
fi
[[ "$tag" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$ && ! -e "$live_var/releases/$tag" ]]
export RELEASE_TAG=$tag
work=$(mktemp -d "$config_dir/.release.XXXXXXXX")
project="hejicheck${work##*.}"
project=${project,,}
export HEJI_VAR="$work/candidate" HEJI_ENV_FILE="$work/test.env"
testdc=(docker compose --env-file "$HEJI_ENV_FILE" -p "$project" -f "$work/src/compose.yaml" -f "$work/src/compose.test.yaml")
setupdc=(docker compose --env-file /dev/null -p "${project}ops" -f "$root/compose.setup.yaml")
export HEJI_BUILD_CONTEXT="$work/src" HEJI_OPS_PROJECT="${project}ops"
mkdir -p "$work/src" "$HEJI_VAR" "$live_var/releases/$tag"
reportdir="$live_var/releases/$tag"
# The daemon resolves bind paths on the host. Keep live configuration after CI checkout cleanup.
mkdir -p "$reportdir/runtime/docker"
cp compose.yaml "$reportdir/runtime/"
cp docker/init-db.sh "$reportdir/runtime/docker/"
# umask 077 + cp keeps source 777 as 700. Postgres (non-root) must read init-db.sh, so open just this file/dir.
chmod 755 "$reportdir/runtime/docker"
chmod 644 "$reportdir/runtime/docker/init-db.sh"
chmod 644 "$reportdir/runtime/compose.yaml"
live=(docker compose --env-file "$live_env" -p heji -f "$reportdir/runtime/compose.yaml")
archive_reports() {
    mkdir -p "$reportdir/tests" || return 1
    cp -r "$work/candidate/logs/tests/." "$reportdir/tests/" || return 1
    if [[ -d "$work/http" ]]; then
        for f in "$work"/http/*.log; do
            [[ ! -f "$f" ]] || cat "$f" >> "$reportdir/tests/$(basename "$f")" || return 1
        done
    fi
    cp -r "$work/candidate/reports/." "$reportdir/" || return 1
    "${setupdc[@]}" run --rm --no-deps -T -v "$reportdir/tests:/source:ro" -v "$live_var/logs/tests:/logs" files sh -ec '
      for f in /source/*.log; do [ -f "$f" ] || continue; n=$(basename "$f"); cp "$f" "/logs/$n.new"; chmod 644 "/logs/$n.new"; mv "/logs/$n.new" "/logs/$n"; done'
}
verify_runtime_log() {
    local marker="heji-log-check-$project-$RANDOM" attempt
    for attempt in {1..30}; do
        [[ ! -S "$HEJI_VAR/log-socket/forward.sock" ]] || break
        sleep 1
    done
    [[ -S "$HEJI_VAR/log-socket/forward.sock" ]] || { echo '日志套接字未就绪。' >&2; return 1; }
    "$@" run --rm --no-deps -T --entrypoint sh migrate -ec 'echo "$1"; sleep 2' sh "$marker" || return 1
    for attempt in {1..30}; do
        if grep -Fq "$marker" "$HEJI_VAR"/logs/runtime/*.log 2>/dev/null; then return 0; fi
        sleep 1
    done
    echo 'Docker 输出未写入 Laravel 的 runtime 日志。' >&2
    return 1
}
cleanup() {
    code=$?
    trap - EXIT
    if [[ -f "$work/test.env" ]]; then
        HEJI_VAR="$work/candidate" HEJI_ENV_FILE="$work/test.env" "${testdc[@]}" down -v --remove-orphans >/dev/null 2>&1 || true
    fi
    if [[ ! -f "$reportdir/evidence-ready" && -d "$work/candidate/logs/tests" ]]; then
        archive_reports || echo '部分失败诊断日志无法保存。' >&2
    fi
    "${setupdc[@]}" run --rm --no-deps -T -v "$work:/discard" files sh -c 'rm -rf /discard/candidate /discard/src' >/dev/null 2>&1 || true
    "${setupdc[@]}" down --remove-orphans >/dev/null 2>&1 || true
    if [[ -n "${env_next:-}" ]]; then rm -f "$env_next"; fi
    rm -rf "$work"
    echo "$code" > "$reportdir/exit-code"
    exit "$code"
}
trap cleanup EXIT
sources=(app artisan bin bootstrap compose.yaml compose.test.yaml compose.setup.yaml composer.json phpunit.xml config database docker lang public resources routes tests .env.example .dockerignore)
[[ ! -f composer.lock ]] || sources+=(composer.lock)
tar --exclude='bootstrap/cache/*.php' -cf - "${sources[@]}" | tar -C "$work/src" -xf -
# Isolation test uses $work/src, not reportdir/runtime. Same umask 077 -> 700 issue, fix it too.
chmod 755 "$work/src/docker"
chmod 644 "$work/src/docker/init-db.sh"
chmod 644 "$work/src/compose.yaml"
sha256sum composer.json | cut -d' ' -f1 > "$reportdir/composer.sha256"
previous=$(cat "$live_var/current" 2>/dev/null || true)
if [[ ! -e "$work/src/composer.lock" && -n "$previous" && -s "$live_var/releases/$previous/composer.lock" ]] &&
   cmp -s "$reportdir/composer.sha256" "$live_var/releases/$previous/composer.sha256"; then
    cp "$live_var/releases/$previous/composer.lock" "$work/src/composer.lock"
fi
"${setupdc[@]}" build dependencies init
"${setupdc[@]}" run --rm --no-deps -T dependencies cat composer.lock > "$work/resolved.lock"
python3 - "$work/resolved.lock" <<'PYLOCK'
import json, sys
with open(sys.argv[1]) as f:
    packages = json.load(f)['packages']
if not any(p['name']=='laravel/framework' and p['version'].lstrip('v').startswith('13.') for p in packages):
    raise SystemExit('依赖锁缺少 Laravel 13。')
PYLOCK
cp "$work/resolved.lock" "$work/src/composer.lock"
chmod 0644 "$work/src/composer.lock"
cp "$work/resolved.lock" "$reportdir/composer.lock"
"${setupdc[@]}" build app-image test-image web-image browser-image logs-image
HEJI_CONFIG_DIR="$work" "${setupdc[@]}" run --rm --no-deps -T --user "$(id -u):$(id -g)" \
    -e HEJI_ENV_FILE=/config/test.env -e HEJI_VAR=/config/candidate init --local-cert
"${testdc[@]}" config --quiet
# Pull the floating tags once, then run both acceptance and production by digest.
export HEJI_POSTGRES_IMAGE=postgres:latest HEJI_REDIS_IMAGE=redis:latest
"${testdc[@]}" pull db redis
postgres_ref=$(docker image inspect --format '{{index .RepoDigests 0}}' "$HEJI_POSTGRES_IMAGE")
redis_ref=$(docker image inspect --format '{{index .RepoDigests 0}}' "$HEJI_REDIS_IMAGE")
for ref in "$postgres_ref" "$redis_ref"; do [[ "$ref" =~ ^[^[:space:]]+@sha256:[0-9a-f]{64}$ ]]; done
export HEJI_POSTGRES_IMAGE=$postgres_ref HEJI_REDIS_IMAGE=$redis_ref
printf '%s\n' "$postgres_ref" "$redis_ref" > "$reportdir/data-images.txt"
bash docker/logdirs "$project" "$work/src/compose.yaml"
"${testdc[@]}" up -d --wait logs
# Random loopback ports prevent staging from reaching the live listener.
export BIND_HTTP=127.0.0.1:0 BIND_HTTPS=127.0.0.1:0
"${testdc[@]}" up -d --wait db redis
if [[ -s "$live_var/current" ]]; then
    RELEASE_TAG=$(cat "$live_var/current") HEJI_ENV_FILE="$live_env" HEJI_VAR="$live_var" "${live[@]}" exec -T app php artisan heji:reset-test-logs || echo "live app 未运行，跳过 reset-test-logs" >&2
fi
"${testdc[@]}" run --rm tests
mkdir -p "$work/http"
python3 tests/operations.py 2>&1 | tee -a "$work/http/common.log"
python3 tests/compose_images.py 2>&1 | tee -a "$work/http/common.log"
"${testdc[@]}" run --rm --no-deps -T migrate
verify_runtime_log "${testdc[@]}"
"${testdc[@]}" up -d --wait app web
port=$("${testdc[@]}" port web 443 | awk -F: '{print $NF}')
python3 tests/https_smoke.py "$port" "$work/http"
"${testdc[@]}" exec -T app php artisan heji:developer browser@example.test
"${testdc[@]}" exec -T app php artisan db:seed --class=DemoSeeder --force
"${testdc[@]}" exec -T app php artisan heji:menu
export HEJI_BROWSER_PASSWORD
HEJI_BROWSER_PASSWORD=$(cat "$work/browser-password")
"${testdc[@]}" run --rm --no-deps -T browser
unset HEJI_BROWSER_PASSWORD
rm -f "$work/browser-password"
# Validate an actual dump/restore into another database before touching production.
"${testdc[@]}" exec -T db sh -ec 'pg_dump -U heji_owner -Fc -f /tmp/verify.dump heji; createdb -U heji_owner heji_restore; pg_restore --exit-on-error -U heji_owner -d heji_restore /tmp/verify.dump; psql -U heji_owner -d heji_restore -Atc "select count(*) from public.roles" | grep -qx 10; rm /tmp/verify.dump'
archive_reports
for required in junit.xml coverage.jsonl tests/common.log tests/shop.laravel.demo.log tests/stock.laravel.demo.log tests/recipe.laravel.demo.log; do
    [[ -s "$reportdir/$required" ]]
done
touch "$reportdir/evidence-ready"
unset BIND_HTTP BIND_HTTPS
export HEJI_VAR=$live_var HEJI_ENV_FILE=$live_env
"${live[@]}" config --quiet
prev=$(cat "$live_var/current" 2>/dev/null || true)
if [[ -n "$prev" ]]; then
    if ! docker image inspect "heji-app:$prev" >/dev/null 2>&1; then echo "old image heji-app:$prev missing, skip backup" >&2; else RELEASE_TAG=$prev "${live[@]}" run --rm --no-deps app php artisan heji:backup || echo "backup failed, continue release" >&2; fi
fi
bash docker/logdirs heji "$reportdir/runtime/compose.yaml"
"${live[@]}" up -d --wait logs
verify_runtime_log "${live[@]}"
"${live[@]}" up -d --wait db redis
"${live[@]}" run --rm --no-deps -T migrate
# Prepare the tag for normal Compose commands; activate it only after the HTTPS checks.
env_next=$(mktemp "$(dirname "$live_env")/.heji-env.XXXXXXXX")
python3 - "$live_env" "$env_next" "$tag" "$postgres_ref" "$redis_ref" <<'PYTAG'
from pathlib import Path
import re, sys
old, staged, tag, postgres, redis = sys.argv[1:]
active = {'RELEASE_TAG': tag, 'HEJI_POSTGRES_IMAGE': postgres, 'HEJI_REDIS_IMAGE': redis}
lines = []
for line in Path(old).read_text().splitlines():
    key = re.match(r'^\s*(?:export\s+)?(\w+)\s*=', line)
    if not key or key[1] not in active:
        lines.append(line)
lines.extend(f'{key}={value}' for key, value in active.items())
Path(staged).write_text('\n'.join(lines)+'\n')
PYTAG
verify_live() {
    "${live[@]}" up -d --wait app scheduler web || return 1
    local liveport
    liveport=$("${live[@]}" port web 443 | head -1 | awk -F: '{print $NF}') || return 1
    for site in shop stock recipe; do
        curl -fsS --noproxy '*' --cacert "$live_var/tls/fullchain.pem" --resolve "$site.laravel.demo:$liveport:127.0.0.1" "https://$site.laravel.demo:$liveport/health" | grep -qx ok || return 1
    done
}
# Keep public local aliases on the last release that passed all checks.
images=(heji-app heji-web heji-test heji-browser heji-logs)
declare -A old_latest
promoted=()
for image in "${images[@]}"; do
    old_latest[$image]=$(docker image ls --no-trunc --quiet "$image:latest")
done
promote_latest() {
    local image
    for image in "${images[@]}"; do
        docker image tag "$image:$tag" "$image:latest" || return 1
        promoted+=("$image")
    done
}
echo "$tag" > "$live_var/current.new"
if ! verify_live || ! promote_latest || ! mv -- "$env_next" "$live_env"; then
    for image in "${promoted[@]}"; do
        if [[ -n "${old_latest[$image]}" ]]; then docker image tag "${old_latest[$image]}" "$image:latest"
        else docker image rm "$image:latest"; fi
    done
    if [[ -n "$prev" ]]; then RELEASE_TAG=$prev "${live[@]}" up -d --no-deps --wait app scheduler web; else "${live[@]}" stop web scheduler app; fi
    rm -f "$live_var/current.new"
    exit 1
fi
mv "$live_var/current.new" "$live_var/current"
echo "Released $tag"
