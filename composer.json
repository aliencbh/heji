{
  "name": "heji/three-sites",
  "type": "project",
  "description": "禾集 · 下单、采购库存与食谱管理",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-pdo_pgsql": "*",
    "ext-redis": "*",
    "laravel/framework": "^13.0",
    "symfony/process": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "mockery/mockery": "^1.6",
    "fakerphp/faker": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {},
    "optimize-autoloader": true
  }
}